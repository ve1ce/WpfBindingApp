<Window x:Class="WpfBindingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfBindingDemo"
        mc:Ignorable="d"
        Title="{DynamicResource App_Title}"
        Height="550"
        Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель выбора языка -->
        <DockPanel Grid.Row="0"
                   Margin="5">
            <TextBlock Text="{DynamicResource Language_Label}"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0" />
            <ComboBox x:Name="LanguageComboBox"
                      Width="140"
                      HorizontalAlignment="Right"
                      SelectedIndex="0"
                      SelectionChanged="LanguageComboBox_SelectionChanged">
                <ComboBoxItem Tag="ru">
                    <TextBlock Text="{DynamicResource Language_Russian}" />
                </ComboBoxItem>
                <ComboBoxItem Tag="en">
                    <TextBlock Text="{DynamicResource Language_English}" />
                </ComboBoxItem>
            </ComboBox>
        </DockPanel>

        <!-- Основные вкладки -->
        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedIndex="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TabName}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding TabContent}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
