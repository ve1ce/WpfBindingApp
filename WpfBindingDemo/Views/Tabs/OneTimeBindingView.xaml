<UserControl x:Class="WpfBindingDemo.Views.Tabs.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400"
             Background="White">

    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="{DynamicResource OneTime_Title}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

            <TextBlock Text="{DynamicResource OneTime_Description}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

            <GroupBox Header="{DynamicResource OneTime_Group1_Header}"
                      Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource OneTime_Group1_SourceLabel}" />
                    <TextBox x:Name="SourceTextBox"
                             Text="{DynamicResource OneTime_Group1_InitialValue}"
                             Margin="0,5,0,5" />

                    <TextBlock Text="{DynamicResource OneTime_Group1_OneTimeLabel}" />
                    <TextBlock Text="{Binding Text, ElementName=SourceTextBox, Mode=OneTime}"
                               Background="LightYellow"
                               Padding="5"
                               Margin="0,5,0,0" />

                    <TextBlock Text="{DynamicResource OneTime_Group1_Footer}"
                               FontStyle="Italic"
                               Foreground="Gray"
                               Margin="0,10,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource OneTime_Group2_Header}"
                      Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource OneTime_Group2_ValueFromVm}" />
                    <TextBox Text="{Binding OneTimeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,5" />

                    <TextBlock Text="{DynamicResource OneTime_Group2_OneTimeLabel}" />
                    <TextBlock Text="{Binding OneTimeValue, Mode=OneTime}"
                               Background="LightYellow"
                               Padding="5"
                               Margin="0,5,0,0" />

                    <Button Content="{DynamicResource OneTime_Group2_Button}"
                            Command="{Binding UpdateOneTimeValueCommand}"
                            Margin="0,10,0,0"
                            Padding="5" />

                    <TextBlock Text="{DynamicResource OneTime_Group2_Footer}"
                               FontStyle="Italic"
                               Foreground="Gray"
                               Margin="0,10,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
