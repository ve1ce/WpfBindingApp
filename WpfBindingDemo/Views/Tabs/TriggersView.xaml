<UserControl x:Class="WpfBindingDemo.Views.Tabs.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="700"
             Background="White">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="{local:Loc Triggers_Title}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="{local:Loc Triggers_Description}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <GroupBox Header="{local:Loc Triggers_Group1_Title}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{local:Loc Triggers_Group1_Intro}" />

                        <Button Content="{local:Loc Triggers_Group1_Button}"
                                Width="200"
                                Height="40"
                                Margin="0,10,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="LightBlue" />
                                    <Setter Property="Foreground"
                                            Value="Black" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="DarkBlue" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </Trigger>

                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="Red" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95"
                                                                    ScaleY="0.95" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="{local:Loc Triggers_Group1_Hint}"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{local:Loc Triggers_Group2_Title}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{local:Loc Triggers_Group2_Intro}" />

                        <TextBox x:Name="DataTriggerTextBox"
                                 Text="{local:Loc Triggers_Group2_TextBox_Placeholder}"
                                 Width="200"
                                 Margin="0,5,0,10" />

                        <Border Width="200"
                                Height="60"
                                CornerRadius="5"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="LightGray" />
                                    <Setter Property="BorderBrush"
                                            Value="Gray" />
                                    <Setter Property="BorderThickness"
                                            Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DataTriggerTextBox}"
                                                     Value="active">
                                            <Setter Property="BorderBrush"
                                                    Value="Green" />
                                            <Setter Property="BorderThickness"
                                                    Value="3" />
                                            <Setter Property="Background"
                                                    Value="LightGreen" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Text, ElementName=DataTriggerTextBox}"
                                                     Value="error">
                                            <Setter Property="BorderBrush"
                                                    Value="Red" />
                                            <Setter Property="BorderThickness"
                                                    Value="3" />
                                            <Setter Property="Background"
                                                    Value="LightCoral" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{local:Loc Triggers_Group2_BorderText}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{local:Loc Triggers_Group2_Hint}"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{local:Loc Triggers_Group3_Title}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{local:Loc Triggers_Group3_Intro}" />

                        <CheckBox x:Name="CheckBox1"
                                  Content="{local:Loc Triggers_Group3_Check1}"
                                  Margin="0,5,0,5" />
                        <CheckBox x:Name="CheckBox2"
                                  Content="{local:Loc Triggers_Group3_Check2}"
                                  Margin="0,5,0,10" />

                        <Button Content="{local:Loc Triggers_Group3_Button}"
                                Width="150"
                                Height="35">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled"
                                            Value="False" />
                                    <Setter Property="Background"
                                            Value="LightGray" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=CheckBox1}"
                                                           Value="True" />
                                                <Condition Binding="{Binding IsChecked, ElementName=CheckBox2}"
                                                           Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled"
                                                    Value="True" />
                                            <Setter Property="Background"
                                                    Value="LightGreen" />
                                            <Setter Property="FontWeight"
                                                    Value="Bold" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="{local:Loc Triggers_Group3_Hint}"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{local:Loc Triggers_Group4_Title}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{local:Loc Triggers_Group4_Intro}" />

                        <Button Content="{local:Loc Triggers_Group4_Button}"
                                Width="200"
                                Height="40"
                                Background="LightBlue"
                                Margin="0,10,0,10">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                To="Green"
                                                                Duration="0:0:0.5" />

                                                <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                To="LightBlue"
                                                                Duration="0:0:0.5"
                                                                BeginTime="0:0:0.5" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <TextBlock Text="{local:Loc Triggers_Group4_Hint}"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <Border BorderBrush="#e3f1fc"
                        BorderThickness="2"
                        CornerRadius="5"
                        Padding="10"
                        Background="AliceBlue">
                    <StackPanel>
                        <TextBlock Text="{local:Loc Triggers_Comparison_Title}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{local:Loc Triggers_Comparison_PropertyTrigger_Title}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_PropertyTrigger_Line1}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_PropertyTrigger_Line2}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_PropertyTrigger_Line3}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{local:Loc Triggers_Comparison_DataTrigger_Title}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_DataTrigger_Line1}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_DataTrigger_Line2}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_DataTrigger_Line3}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Loc Triggers_Comparison_MultiDataTrigger_Title}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_MultiDataTrigger_Line1}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_MultiDataTrigger_Line2}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_MultiDataTrigger_Line3}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{local:Loc Triggers_Comparison_EventTrigger_Title}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_EventTrigger_Line1}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_EventTrigger_Line2}" />
                                <TextBlock Text="{local:Loc Triggers_Comparison_EventTrigger_Line3}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>