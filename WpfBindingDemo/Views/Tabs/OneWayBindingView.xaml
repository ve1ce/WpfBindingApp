<UserControl x:Class="WpfBindingDemo.Views.Tabs.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="White">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="{DynamicResource OneWay_Title}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="{DynamicResource OneWay_Description}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <GroupBox Header="{DynamicResource OneWay_Group1_Header}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource OneWay_Group1_Description}" />
                        <Slider x:Name="SourceSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="30"
                                Margin="0,5,0,5" />

                        <ProgressBar Value="{Binding Value, ElementName=SourceSlider, Mode=OneWay}"
                                     Height="20"
                                     Margin="0,0,0,5" />

                        <TextBlock Text="{DynamicResource OneWay_Group1_ValueTitle}"
                                   Margin="0,10,0,5" />
                        <TextBlock Text="{Binding Value, ElementName=SourceSlider, Mode=OneWay}"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{DynamicResource OneWay_Group1_Footer}"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource OneWay_Group2_Header}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource OneWay_Group2_SourceLabel}" />
                        <TextBox Text="{Binding SourceValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="{DynamicResource OneWay_Group2_OneWayLabel}" />

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock Text="{Binding SourceValue, Mode=OneWay}"
                                       Background="LightYellow"
                                       Padding="3" />
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock Background="#b9a3f0"
                                       Padding="3">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}{1}">
                                        <Binding Source="{StaticResource OneWay_Group2_FormatPrefix}" />
                                        <Binding Path="SourceValue" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,10">
                            <TextBlock>
                                <Run Text="{DynamicResource OneWay_Group2_LengthPrefix}" />
                                <Run Text="{Binding SourceValue.Length, Mode=OneWay}"
                                     FontWeight="Bold" />
                                <Run Text="{DynamicResource OneWay_Group2_LengthSuffix}" />
                            </TextBlock>
                        </Border>

                        <TextBlock Text="{DynamicResource OneWay_Group2_Footer}"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource OneWay_Group3_Header}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource OneWay_Group3_Intro}" />

                        <TextBox x:Name="ComparisonSource"
                                 Text="{DynamicResource OneWay_Group3_InitialText}"
                                 Margin="0,5,0,5" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource OneWay_Group3_LeftTitle}" />
                                <TextBlock Text="{Binding Text, ElementName=ComparisonSource, Mode=OneWay}"
                                           Background="LightYellow"
                                           Padding="5"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource OneWay_Group3_RightTitle}" />
                                <TextBlock Text="{Binding Text, ElementName=ComparisonSource}"
                                           Background="#b9a3f0"
                                           Padding="5"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource OneWay_Group3_Footer}"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource OneWay_Group4_Header}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource OneWay_Group4_Intro}" />

                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource OneWay_Group4_NumberA}" />
                                <TextBox Text="{Binding NumberA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,5,5" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource OneWay_Group4_NumberB}" />
                                <TextBox Text="{Binding NumberB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5,2,0,5" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource OneWay_Group4_ResultIntro}" />

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock>
                                <Run Text="{DynamicResource OneWay_Group4_Sum}" />
                                <Run Text="{Binding Sum, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock>
                                <Run Text="{DynamicResource OneWay_Group4_Difference}" />
                                <Run Text="{Binding Difference, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,0">
                            <TextBlock>
                                <Run Text="{DynamicResource OneWay_Group4_Product}" />
                                <Run Text="{Binding Product, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>