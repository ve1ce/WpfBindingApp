<UserControl x:Class="WpfBindingDemo.Views.Tabs.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="White">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Односторонняя привязка"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="Односторонняя привязка обновляет цель при изменении источника, но изменения цели НЕ влияют на источник."
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <GroupBox Header="1. Прямая OneWay привязка между элементами"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Slider → ProgressBar (OneWay):" />
                        <Slider x:Name="SourceSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="30"
                                Margin="0,5,0,5" />

                        <ProgressBar Value="{Binding Value, ElementName=SourceSlider, Mode=OneWay}"
                                     Height="20"
                                     Margin="0,0,0,5" />

                        <TextBlock Text="Значение:"
                                   Margin="0,10,0,5" />
                        <TextBlock Text="{Binding Value, ElementName=SourceSlider, Mode=OneWay}"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Изменение слайдера обновляет ProgressBar и TextBlock, но обратно - нет"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. OneWay привязка через ViewModel"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Источник данных (можно менять):" />
                        <TextBox Text="{Binding SourceValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="OneWay привязки к одному свойству:" />

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock Text="{Binding SourceValue, Mode=OneWay}"
                                       Background="LightYellow"
                                       Padding="3" />
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock Text="{Binding SourceValue, StringFormat='Значение: {0}', Mode=OneWay}"
                                       Background="#b9a3f0"
                                       Padding="3" />
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,10">
                            <TextBlock>
                                <Run Text="Длина:" />
                                <Run Text="{Binding SourceValue.Length, Mode=OneWay}"
                                     FontWeight="Bold" />
                                <Run Text="символов" />
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Все элементы обновляются при изменении TextBox, но не могут изменить его"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. OneWay vs Default Binding Mode"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Для TextBlock Mode=OneWay установлен по умолчанию:" />

                        <TextBox x:Name="ComparisonSource"
                                 Text="Тестовый текст"
                                 Margin="0,5,0,5" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                <TextBlock Text="Явно указан OneWay:" />
                                <TextBlock Text="{Binding Text, ElementName=ComparisonSource, Mode=OneWay}"
                                           Background="LightYellow"
                                           Padding="5"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Режим по умолчанию:" />
                                <TextBlock Text="{Binding Text, ElementName=ComparisonSource}"
                                           Background="#b9a3f0"
                                           Padding="5"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Оба работают одинаково, так как OneWay - default для TextBlock"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="4. OneWay к вычисляемому свойству"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Два числа (TwoWay привязка):" />

                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Число A:" />
                                <TextBox Text="{Binding NumberA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,5,5" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Число B:" />
                                <TextBox Text="{Binding NumberB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5,2,0,5" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Вычисляемые свойства (OneWay, только для чтения):" />

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock>
                                <Run Text="Сумма:" />
                                <Run Text="{Binding Sum, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock>
                                <Run Text="Разность:" />
                                <Run Text="{Binding Difference, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,0">
                            <TextBlock>
                                <Run Text="Произведение:" />
                                <Run Text="{Binding Product, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>