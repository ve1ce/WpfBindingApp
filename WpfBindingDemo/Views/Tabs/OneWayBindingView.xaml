<UserControl x:Class="WpfBindingDemo.Views.Tabs.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="White">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="{Tr 'OneWay.Title'}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="{Tr 'OneWay.Description'}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <GroupBox Header="{Tr 'OneWay.Group1.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'OneWay.Group1.Label'}" />
                        <Slider x:Name="SourceSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="30"
                                Margin="0,5,0,5" />

                        <ProgressBar Value="{Binding Value, ElementName=SourceSlider, Mode=OneWay}"
                                     Height="20"
                                     Margin="0,0,0,5" />

                        <TextBlock Text="{Tr 'OneWay.Group1.ValueLabel'}"
                                   Margin="0,10,0,5" />
                        <TextBlock Text="{Binding Value, ElementName=SourceSlider, Mode=OneWay}"
                                   FontWeight="Bold" />

                        <TextBlock Text="{Tr 'OneWay.Group1.Note'}"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr 'OneWay.Group2.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'OneWay.Group2.SourceLabel'}" />
                        <TextBox Text="{Binding SourceValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="{Tr 'OneWay.Group2.OneWayLabel'}" />

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock Text="{Binding SourceValue, Mode=OneWay}"
                                       Background="LightYellow"
                                       Padding="3" />
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock Text="{Tr 'OneWay.Group2.ValueFormat', {Binding SourceValue}}"
                                       Background="#b9a3f0"
                                       Padding="3" />
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,10">
                            <TextBlock>
                                <Run Text="{Binding Source=Длинна:, Mode=OneWay}" />
                                <Run Text="{Binding SourceValue.Length, Mode=OneWay}"
                                    FontWeight="Bold" />
                                <Run Text="{Binding Source=символов, Mode=OneWay}" />
                            </TextBlock>
                        </Border>

                        <TextBlock Text="{Tr 'OneWay.Group2.Note'}"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr 'OneWay.Group3.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'OneWay.Group3.Label'}" />

                        <TextBox x:Name="ComparisonSource"
                                 Text="{Binding Source=Пример текста, Mode=OneWay}"
                                 Margin="0,5,0,5" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">
                                <TextBlock Text="{Tr 'OneWay.Group3.ExplicitOneWayLabel'}" />
                                <TextBlock Text="{Binding Text, ElementName=ComparisonSource, Mode=OneWay}"
                                           Background="LightYellow"
                                           Padding="5"
                                           Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="{Tr 'OneWay.Group3.DefaultModeLabel'}" />
                                <TextBlock Text="{Binding Text, ElementName=ComparisonSource}"
                                           Background="#b9a3f0"
                                           Padding="5"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Tr 'OneWay.Group3.Note'}"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr 'OneWay.Group4.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'OneWay.Group4.Label'}" />

                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Tr 'OneWay.Group4.NumberALabel'}" />
                                <TextBox Text="{Binding NumberA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,5,5" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Tr 'OneWay.Group4.NumberBLabel'}" />
                                <TextBox Text="{Binding NumberB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="5,2,0,5" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Tr 'OneWay.Group4.ComputedLabel'}" />

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock>
                                <Run Text="{Binding Source=Сумма:, Mode=OneWay}" />
                                <Run Text="{Binding Sum, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,5">
                            <TextBlock>
                                <Run Text="{Binding Source=Разность:, Mode=OneWay}" />
                                <Run Text="{Binding Difference, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>

                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5"
                                Margin="0,5,0,0">
                            <TextBlock>
                                <Run Text="{Binding Source=Произведение:, Mode=OneWay}" />
                                <Run Text="{Binding Product, Mode=OneWay}"
                                     FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
