<UserControl x:Class="WpfBindingDemo.Views.Tabs.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="White">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="Двусторонняя привязка"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="Двухсторонняя привязка обновляет и источник, и цель при изменениях в любую сторону."
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <GroupBox Header="1. Прямая TwoWay привязка между элементами"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Slider и TextBox связаны TwoWay привязкой:" />
                        <Slider x:Name="DirectSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Margin="0,5,0,5" />

                        <TextBox Text="{Binding Value, ElementName=DirectSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="Изменение ползунка обновляет TextBox и наоборот"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. TwoWay привязка через ViewModel"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="Все элементы связаны с одним свойством ViewModel:" />

                        <TextBlock Text="Имя пользователя:"
                                   Margin="0,10,0,5" />

                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5" />

                        <TextBlock Text="{Binding UserName}"
                                   Background="LightYellow"
                                   Padding="5"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Возраст:"
                                   Margin="0,10,0,5" />

                        <Slider Value="{Binding Age, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="100"
                                Margin="0,0,0,5" />

                        <TextBox Text="{Binding Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5" />

                        <TextBlock Text="{Binding Age, StringFormat='Возраст: {0} лет'}"
                                   Background="LightYellow"
                                   Padding="5"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Активен:"
                                   Margin="0,10,0,5" />

                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  Content="Пользователь активен"
                                  Margin="0,0,0,5" />

                        <TextBlock Text="{Binding IsActive, StringFormat='Статус активности: {0}'}"
                                   Background="LightYellow"
                                   Padding="5" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3. Разница UpdateSourceTrigger"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="PropertyChanged (обновление при каждом изменении):" />
                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="LostFocus (обновление при потере фокуса):" />
                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="Explicit (обновление только при вызове UpdateSource):" />
                        <TextBox x:Name="ExplicitTextBox"
                                 Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 Margin="0,5,0,5" />

                        <Button Content="Обновить источник"
                                Click="UpdateExplicitBinding_Click"
                                Padding="5"
                                Width="150" />
                    </StackPanel>
                </GroupBox>

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Background="LightYellow">
                    <StackPanel>
                        <TextBlock Text="Текущие значения в ViewModel:"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />
                        <TextBlock Text="{Binding CurrentValues}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>