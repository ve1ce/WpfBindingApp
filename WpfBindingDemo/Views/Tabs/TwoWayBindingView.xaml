<UserControl x:Class="WpfBindingDemo.Views.Tabs.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBindingDemo.Views.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="600"
             Background="White">

    <Grid Margin="10">
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="{Tr 'TwoWay.Title'}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <TextBlock Text="{Tr 'TwoWay.Description'}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />

                <GroupBox Header="{Tr 'TwoWay.Group1.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'TwoWay.Group1.Label'}" />
                        <Slider x:Name="DirectSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Margin="0,5,0,5" />

                        <TextBox Text="{Binding Value, ElementName=DirectSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />

                        <TextBlock Text="{Tr 'TwoWay.Group1.Note'}"
                                   FontStyle="Italic"
                                   Foreground="Gray" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr 'TwoWay.Group2.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'TwoWay.Group2.Label'}" />

                        <TextBlock Text="{Tr 'TwoWay.Group2.UserNameLabel'}"
                                   Margin="0,10,0,5" />

                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5" />

                        <TextBlock Text="{Binding UserName}"
                                   Background="LightYellow"
                                   Padding="5"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{Tr 'TwoWay.Group2.AgeLabel'}"
                                   Margin="0,10,0,5" />

                        <Slider Value="{Binding Age, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="100"
                                Margin="0,0,0,5" />

                        <TextBox Text="{Binding Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,5" />

                        <TextBlock Text="{Tr 'TwoWay.AgeFormat', {Binding Age}}"
                                   Background="LightYellow"
                                   Padding="5"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="{Tr 'TwoWay.Group2.ActiveLabel'}"
                                   Margin="0,10,0,5" />

                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  Content="{Tr 'TwoWay.Group2.ActiveCheckbox'}"
                                  Margin="0,0,0,5" />

                        <TextBlock Text="{Tr 'TwoWay.ActiveStatusFormat', {Binding IsActive}}"
                                   Background="LightYellow"
                                   Padding="5" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{Tr 'TwoWay.Group3.Header'}"
                          Margin="0,0,0,15">
                    <StackPanel Margin="5">
                        <TextBlock Text="{Tr 'TwoWay.Group3.PropertyChangedLabel'}" />
                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="{Tr 'TwoWay.Group3.LostFocusLabel'}" />
                        <TextBox Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Margin="0,5,0,10" />

                        <TextBlock Text="{Tr 'TwoWay.Group3.ExplicitLabel'}" />
                        <TextBox x:Name="ExplicitTextBox"
                                 Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 Margin="0,5,0,5" />

                        <Button Content="{Tr 'TwoWay.Group3.UpdateSourceButton'}"
                                Click="UpdateExplicitBinding_Click"
                                Padding="5"
                                Width="150" />
                    </StackPanel>
                </GroupBox>

                <Border BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Background="LightYellow">
                    <StackPanel>
                        <TextBlock Text="{Tr 'TwoWay.CurrentValuesTitle'}"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />
                        <TextBlock Text="{Binding CurrentValues}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
